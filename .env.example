# Banking Data Platform — .env.example (TEMPLATE)
# Copy to .env and fill secrets — .env is gitignored, never committed.
# See Architecture.md sections 4,5,8,11,14 and PROJECT_PLAN.md Phase 0
# Generate local secrets: powershell -Command "[guid]::NewGuid().ToString(); -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})"

# -----------------
# Environment
# -----------------
ENVIRONMENT=local
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# -----------------
# PostgreSQL — single instance, three databases (Architecture 8.1)
# -----------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_postgres_superuser
# Databases
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_CATALOG_DB=iceberg_catalog
POSTGRES_WAREHOUSE_DB=banking_dw
# Role passwords (Terraform + compose use these)
POSTGRES_AIRFLOW_APP_PASSWORD=REPLACE_ME_airflow_app
POSTGRES_CATALOG_APP_PASSWORD=REPLACE_ME_catalog_app
POSTGRES_ETL_WRITER_PASSWORD=REPLACE_ME_etl_writer
POSTGRES_DQ_WRITER_PASSWORD=REPLACE_ME_dq_writer
POSTGRES_STREAMLIT_READER_PASSWORD=REPLACE_ME_streamlit_reader
POSTGRES_GRAFANA_READER_PASSWORD=REPLACE_ME_grafana_reader

# -----------------
# MongoDB replica set (Architecture 5.1-5.2 — rs0 required for change streams)
# -----------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_ME_mongo_root
MONGO_DB=banking
MONGO_REPLICA_SET=rs0
# Full URI built from above — override if needed
MONGO_URI=mongodb://admin:REPLACE_ME_mongo_root@mongo:27017/banking?replicaSet=rs0&authSource=admin

# -----------------
# S3-compatible object store — local MinIO (Architecture 4.2, 6.2)
# -----------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=banking-lakehouse
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=REPLACE_ME_minio_secret
# Warehouse layout s3://<bucket>/<env>/warehouse/...
S3_WAREHOUSE_PATH=s3://banking-lakehouse/local/warehouse
S3_CHECKPOINT_PATH=s3://banking-lakehouse/local/checkpoints/flink
S3_DQ_DOCS_PATH=s3://banking-lakehouse/local/dq_docs

# -----------------
# Iceberg Catalog (JDBC on postgres — Architecture 6.1)
# -----------------
ICEBERG_CATALOG_NAME=banking
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg_catalog
ICEBERG_CATALOG_WAREHOUSE=s3://banking-lakehouse/local/warehouse

# -----------------
# Ingestion (Architecture 5.2 — profiled 2026-09-20, docs/profiling.md)
# -----------------
INGEST_OVERLAP_MINUTES=10
INGEST_BATCH_ID_PREFIX=local
# Actual Mongo collections (10) + counts from mongosh banking:
# customers 60k, accounts 95k, transactions 2M, branches 150, loans 22k, cards 65k, card_transactions 3M, loan_payments 600k, support_tickets 25k, employees 1.8k
INGEST_COLLECTIONS=customers,accounts,transactions,branches,loans,cards,card_transactions,loan_payments,support_tickets,employees
# Watermark field per collection — profiled: all have created_at 100% (no updated_at, no nulls), branches full refresh, 2M/3M use _id tiebreaker
# customers,accounts,loans,cards,card_transactions,loan_payments,support_tickets,employees,transactions -> created_at | branches -> full_refresh | transactions/card_transactions -> created_at + _id

# -----------------
# Data Quality Gate (Architecture 11.3)
# -----------------
DQ_GATE_MIN_PASS_PCT=98.0
# Critical checks must be 100% regardless of score

# -----------------
# Security — PII masking (Architecture 14.2)
# -----------------
# HMAC secret for masking restricted PII — generate once, keep stable per env
PII_HMAC_SECRET=REPLACE_ME_32_char_hmac_secret_generate_me
PII_HMAC_SALT=REPLACE_ME_salt

# -----------------
# Airflow (Architecture 9)
# -----------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=REPLACE_ME_fernet_key_32_urlsafe_base64
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_app:REPLACE_ME_airflow_app@postgres:5432/airflow
# Connections via AIRFLOW_CONN_* env vars, not in this file

# -----------------
# Databricks — only needed from Phase 1 onward that needs real compute (Architecture 4.3, ADR 3)
# -----------------
# Leave empty for pure local development
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_WORKSPACE_ID=

# -----------------
# Observability (Architecture 12-13)
# -----------------
PUSHGATEWAY_URL=http://localhost:19091
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_grafana_admin
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# -----------------
# LLM agent — Gold on top (Architecture 8.4 + ADR 007)
# -----------------
# Pasted key lives in .env only (.env is gitignored via .gitignore:13, blocked by .githooks/pre-commit gitleaks).
# Never commit this file with a real key. CI uses GitHub Environments secrets, not .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Agent guardrails: only serving.* + ops.* read-only via streamlit_reader (no raw PII — HMAC only)
AGENT_MAX_ROWS=100
AGENT_SQL_TIMEOUT_MS=5000

# -----------------
# Spark (local)
# -----------------
SPARK_SHUFFLE_PARTITIONS=16
SPARK_SQL_ADAPTIVE_ENABLED=true
JAVA_HOME=

# -----------------
# Terraform (Phase 6) — sensitive vars via TF_VAR_* env, not committed
# -----------------
# TF_VAR_etl_writer_password, TF_VAR_streamlit_reader_password etc. come from above
# TF state backend bucket/key configured in terraform/envs/<env>/backend.hcl
FRESHNESS_SLO_SECONDS=93600
