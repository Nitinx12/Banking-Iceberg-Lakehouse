# ============================================================
# StreamFlix Lakehouse - Environment Configuration (TEMPLATE)
# Copy to .env and fill secrets — .env is gitignored
#
# These values target the Databricks workspace. Local runs
# (`uv run python main.py pipeline`, no Databricks runtime) ignore the
# catalog/paths above and use repo-local defaults instead:
#   sources  -> landing/
#   warehouse/checkpoints/quarantine -> .spark/
#   tables   -> Hive-style two-part names (bronze.watch_events)
# ============================================================

# -----------------
# Databricks Workspace
# -----------------
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapiREPLACE_ME
DATABRICKS_WORKSPACE_ID=REPLACE_ME
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE_ME

# -----------------
# Unity Catalog Configuration (sql/init_schema.sql — catalog streamflix-lakehouse)
# -----------------
CATALOG_NAME=streamflix-lakehouse
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold
INIT_SCHEMA=init_schema
# Back-compat aliases for src/config.py
CATALOG_BRONZE=bronze
CATALOG_SILVER=silver
CATALOG_GOLD=gold

# -----------------
# Data Source Paths (Volumes)
# -----------------
RAW_DATA_PATH=/Volumes/streamflix-lakehouse/bronze/raw_data
CHECKPOINT_PATH=/Volumes/streamflix-lakehouse/bronze/checkpoints
QUARANTINE_PATH=/Volumes/streamflix-lakehouse/silver/quarantine

# -----------------
# Quality & Audit
# -----------------
AUDIT_TABLE=streamflix-lakehouse.silver.audit_log
LINEAGE_TABLE=streamflix-lakehouse.init_schema.lineage
QUALITY_THRESHOLD=0.95
MAX_FAIL_COUNT=100

# -----------------
# Spark Configuration
# -----------------
# 16 matches the data volume (~10k rows/table); 200 tiny tasks per shuffle
# adds pure scheduling overhead. Raise only if row counts grow 100x+.
SPARK_SHUFFLE_PARTITIONS=16
SPARK_SQL_ADAPTIVE_ENABLED=true

# -----------------
# Environment
# -----------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
DEBUG_MODE=false
