# StreamFlix — local dev secrets stand-in for Databricks Secrets + KMS
# Copy to .env and fill in. .env is gitignored (see .gitignore + protect-files.sh).
# On Databricks CE notebooks, these become dbutils.widgets / Databricks Secrets (see src/config.py).

# Databricks workspace (Community Edition)
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=dapiREPLACE_ME
DATABRICKS_CLUSTER_ID=REPLACE_ME
DATABRICKS_WAREHOUSE_ID=

# Landing / storage — DBFS on CE, S3/ADLS path in production (UC external location)
LANDING_ROOT=/dbfs/mnt/landing
CHECKPOINT_ROOT=/dbfs/mnt/checkpoints

# Catalog / Hive DBs — Hive metastore on CE (bronze/silver/gold), Unity Catalog in prod
# sql/init_schema.sql creates catalog `tham` + schema `init_schema` (UC) / database tham_init_schema (CE fallback)
CATALOG_NAME=tham
CATALOG_SCHEMA=init_schema
CATALOG_BRONZE=bronze
CATALOG_SILVER=silver
CATALOG_GOLD=gold

# Env flag
ENV=dev
