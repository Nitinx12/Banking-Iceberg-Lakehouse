# .gitattributes — line-ending policy (Architecture 16.1); .editorconfig carries the editor side
* text=auto

# Source files are always LF in the index
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.tf    text eol=lf
*.hcl   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.scala text eol=lf
Dockerfile* text eol=lf

# Windows-only automation keeps CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.parquet binary
*.woff2  binary
