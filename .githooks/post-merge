#!/usr/bin/env bash
# .githooks/post-merge — keep the venv honest after pulls/merges.
set -uo pipefail

# Only relevant when dependency pins actually moved; avoids a full uv sync on every pull.
if git diff --name-only HEAD@{1} HEAD 2>/dev/null | grep -q '^uv\.lock$'; then
  echo "[warn] uv.lock changed upstream — run: uv sync (or make setup)"
fi

# New migrations/DDL on the serving layer need a re-apply in the local stack.
if git diff --name-only HEAD@{1} HEAD 2>/dev/null | grep -q '^sql/'; then
  echo "[info] sql/ changed — consider: docker compose --profile core up -d postgres (re-init applies sql/init_postgres.sql)"
fi
