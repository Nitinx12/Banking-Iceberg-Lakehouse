#!/usr/bin/env bash
# .githooks/pre-commit — fast local gate (Architecture 16.3, budget <15s)
set -euo pipefail

# Block .env and secrets
if git diff --cached --name-only | grep -Eq '^\.env(\.docker)?$'; then
  echo "✖ refusing to commit .env or .env.docker (use .env.example)" >&2
  exit 1
fi

# Simple secret scan on staged files (gitleaks if installed)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose --redact || { echo "✖ gitleaks found secrets" >&2; exit 1; }
else
  # fallback: block obvious tokens in staged diff (assignment of a value-like literal,
  # not variable references like aws_secret_access_key=secret_key)
  pattern="(DATABRICKS_TOKEN|AWS_SECRET_ACCESS_KEY|PII_HMAC_SECRET)[[:space:]]*=[[:space:]]*[\"']?[A-Za-z0-9/+_-]{16,}"
  if git diff --cached | grep -Eiq "$pattern"; then
    # allow if value is REPLACE_ME placeholder
    if git diff --cached | grep -Eq 'REPLACE_ME'; then
      echo "⚠ staged file contains REPLACE_ME placeholder — ok for .env.example"
    else
      echo "⚠ staged diff contains potential secret — review .env handling" >&2
    fi
  fi
fi

# Large file guard 500KB (ACMR only — deletions have no file to stat)
large=$(git diff --cached --name-only --diff-filter=ACMR | xargs -r -I{} sh -c 'test -f "{}" && wc -c < "{}"' 2>/dev/null | awk '$1>512000 {print $1}' | wc -l | tr -d ' ')
if [ "${large:-0}" -gt 0 ]; then
  echo "⚠ staged file >500KB — if intentional use: git add -f <file>" >&2
fi

# ruff format + lint on staged Python (fast)
if command -v uv >/dev/null 2>&1; then
  uv run ruff format --check . >/dev/null 2>&1 || { echo "✖ ruff format check failed — run: make lint or uv run ruff format ."; exit 1; }
  uv run ruff check . >/dev/null 2>&1 || { echo "✖ ruff check failed — run: uv run ruff check ."; exit 1; }
elif command -v ruff >/dev/null 2>&1; then
  ruff format --check . >/dev/null 2>&1 || { echo "✖ ruff format check failed"; exit 1; }
  ruff check . >/dev/null 2>&1 || { echo "✖ ruff check failed"; exit 1; }
fi

# yamllint on changed YAML
if command -v yamllint >/dev/null 2>&1; then
  changed_yml=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ya?ml$' || true)
  if [ -n "$changed_yml" ]; then
    echo "$changed_yml" | xargs yamllint -d relaxed 2>&1 | head -20 || true
  fi
fi

# terraform fmt check
if command -v terraform >/dev/null 2>&1; then
  tf_changed=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tf$' || true)
  if [ -n "$tf_changed" ]; then
    terraform fmt -check -diff $(git diff --cached --name-only | xargs dirname | sort -u) 2>&1 | head -40 || { echo "✖ terraform fmt check failed"; exit 1; }
  fi
fi

echo "✓ pre-commit passed"
