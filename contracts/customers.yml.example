# contracts/<collection>.yml — data contract example (Architecture 5.4, PROJECT_PLAN Phase 0 task)
# One file per collection. Draft after profiling (counts, field types, null rates, watermark candidates)
collection: customers
watermark_field: updated_at
schema_version: "1.0"
fields:
  - name: _id
    type: string
    required: true
    # watermark: updated_at is set on every write — query: {updated_at: {$gt: lastWatermark}}
  - name: name
    type: string
    required: true
  - name: email
    type: string
    required: false
    pii: true
    class: confidential
  - name: updated_at
    type: timestamp
    required: true
drift_policy:
  new_field: warn
  removed_required_field: fail
  type_change: fail  # quarantine batch, alert

# Adjust to real sample documents after profiling. Copy this to customers.yml, accounts.yml, etc.
