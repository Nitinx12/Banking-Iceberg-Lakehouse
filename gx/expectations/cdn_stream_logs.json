{
  "expectation_suite_name": "cdn_stream_logs",
  "data_asset_type": null,
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "log_id" },
      "meta": { "reason": "PK null — quarantine" }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "log_id" },
      "meta": { "reason": "duplicate log_id (generator 0.5%) — quarantine" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "bitrate_kbps", "mostly": 0.98 },
      "meta": { "reason": "null bitrate (generator 2%) — quarantine" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "rebuffer_ms", "min_value": 0, "max_value": 60000 },
      "meta": { "reason": "negative rebuffer — quarantine" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "event_timestamp", "min_value": "2020-01-01T00:00:00", "max_value": null, "parse_strings_as_datetimes": true },
      "meta": { "reason": "future timestamp — quarantine; late-arriving >7d flagged in quality_checks.py" }
    }
  ],
  "meta": {
    "great_expectations_version": "1.23.0",
    "streamflix_layer": "silver",
    "quarantine_table": "silver.quarantine",
    "sessionization": "gap-based 30-min sessions via src/core/sessionization.py"
  },
  "ge_cloud_id": null
