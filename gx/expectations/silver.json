{
  "expectation_suite_name": "silver",
  "expectations": [
    { "expectation_type": "expect_column_values_to_not_be_null", "kwargs": { "column": "customer_id" } },
    { "expectation_type": "expect_column_values_to_be_unique", "kwargs": { "column": "customer_id" } },
    { "expectation_type": "expect_column_values_to_match_regex", "kwargs": { "column": "email_hmac", "regex": "^[a-f0-9]{64}$" } },
    { "expectation_type": "expect_column_values_to_match_regex", "kwargs": { "column": "phone_hmac", "regex": "^[a-f0-9]{64}$" } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "credit_score", "min_value": 300, "max_value": 900 } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "annual_income", "min_value": 0, "max_value": 10000000 } },
    { "expectation_type": "expect_column_values_to_be_unique", "kwargs": { "column": "account_id" } },
    { "expectation_type": "expect_column_values_to_not_be_null", "kwargs": { "column": "account_id" } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "balance", "min_value": 0, "max_value": 10000000 } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "amount", "min_value": 0.01, "max_value": 1000000 } },
    { "expectation_type": "expect_column_values_to_be_in_set", "kwargs": { "column": "account_type", "value_set": ["Current", "Savings"] } },
    { "expectation_type": "expect_column_values_to_be_in_set", "kwargs": { "column": "status", "value_set": ["Active", "Closed", "Suspended"] } },
    { "expectation_type": "expect_column_pair_values_A_to_be_greater_than_B", "kwargs": { "column_A": "expiry_date", "column_B": "issue_date", "or_equal": false } }
  ]
}
